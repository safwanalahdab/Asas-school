# =========================================================
# Asas School Backend - Production environment contract
# =========================================================
#
# Used with:
#   DJANGO_SETTINGS_MODULE=config.production_settings
#
# This file contains placeholders only. Never commit real values.
# Real files such as .env.production / .env.production.local are git-ignored.
#
# Process environment variables take precedence over a .env file in the
# project root (the base settings read .env without overwriting).
#
# Sections:
#   [Required]      Loading fails with ImproperlyConfigured if missing/invalid.
#   [Optional]      Safe production default applies when omitted.
#   [Enable later]  Keep the initial value until the step is verified.
#
# Expected domain structure (examples only, not real domains):
#   Frontend: https://app.example.com
#   Backend:  https://api.example.com


# =========================================================
# Core [Required]
# =========================================================

# Random value, at least 50 characters. Must not start with "django-insecure-".
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=PUT_RANDOM_SECRET_KEY_HERE

# Do not set DEBUG in production. DEBUG=True is rejected.
# DEBUG=False

# Hostnames ONLY: no scheme, no port, no path, no wildcard.
# localhost / 127.0.0.1 / * are rejected.
ALLOWED_HOSTS=api.example.com


# =========================================================
# Frontend / Backend Origins [Required]
# =========================================================

# Full origins WITH https://, comma separated, no path or trailing path.
# Rejected: http://, wildcards, localhost, *.vercel.app, path/query/fragment.
FRONTEND_ORIGINS=https://app.example.com
BACKEND_ORIGINS=https://api.example.com


# =========================================================
# JWT [Required]
# =========================================================

# Random value, at least 32 characters, different from SECRET_KEY.
JWT_SIGNING_KEY=PUT_RANDOM_JWT_SIGNING_KEY_HERE


# =========================================================
# Cookies [Optional]
# =========================================================

# Secure cookies are always enforced in production.
# Setting JWT_COOKIE_SECURE=False or CSRF_COOKIE_SECURE=False is rejected.

# Allowed: Lax, Strict, None. Default in production: Lax
# (frontend and backend are subdomains of the same root domain).
# JWT_COOKIE_SAMESITE=Lax
# CSRF_COOKIE_SAMESITE=Lax

# Leave unset so cookies stay host-only on the backend domain.
# If set, plain domain only (no scheme, port or path).
# JWT_COOKIE_DOMAIN=


# =========================================================
# PostgreSQL [Required]
# =========================================================

DB_NAME=PUT_DATABASE_NAME_HERE
DB_USER=PUT_DATABASE_USER_HERE
DB_PASSWORD=PUT_DATABASE_PASSWORD_HERE
DB_HOST=127.0.0.1
# Whole number between 1 and 65535.
DB_PORT=5432

# Required and chosen by DevOps according to the connection type.
# Allowed: disable, allow, prefer, require, verify-ca, verify-full.
# Same-server PostgreSQL over localhost/socket commonly uses "disable" or
# "prefer"; use "require" or stricter if the connection leaves the server.
DB_SSLMODE=PUT_SSLMODE_HERE


# =========================================================
# Redis cache [Required]
# =========================================================

# Shared Django default cache for throttling across Gunicorn workers.
# Redis must listen on localhost only and must not be exposed publicly.
REDIS_URL=redis://127.0.0.1:6379/1


# =========================================================
# Media files [Required]
# =========================================================

# Absolute POSIX path on the persistent storage volume. Relative paths are
# rejected. Django does not create it: DevOps creates the directory and grants
# write access to the Gunicorn user. Nginx serves it.
MEDIA_ROOT=/absolute/path/to/persistent/media

# [Optional] Must start and end with "/". Default: /media/
# MEDIA_URL=/media/


# =========================================================
# HTTPS / HSTS [Enable later]
# =========================================================

# SECURE_SSL_REDIRECT and SECURE_PROXY_SSL_HEADER are always on in production.
# Nginx must set: proxy_set_header X-Forwarded-Proto $scheme;

# Keep 0 until HTTPS is verified on the final domain, then raise gradually
# (for example 3600, then 31536000). Whole number >= 0.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# Preload requires INCLUDE_SUBDOMAINS=True and SECONDS >= 31536000.
SECURE_HSTS_PRELOAD=False


# =========================================================
# Firebase Push Notifications [Optional / Enable later]
# =========================================================

FIREBASE_PUSH_ENABLED=False

# Required only when FIREBASE_PUSH_ENABLED=True.
# FIREBASE_PROJECT_ID=PUT_FIREBASE_PROJECT_ID_HERE

# Required only when FIREBASE_PUSH_ENABLED=True.
# Absolute path to the service account JSON stored OUTSIDE the project
# directory, readable only by the Gunicorn user. Never commit this file.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/project/firebase-service-account.json


# =========================================================
# Other [Optional]
# =========================================================

# DEBUG, INFO, WARNING, ERROR, CRITICAL. Default: INFO
# LOG_LEVEL=INFO

# Default: 2
# MOBILE_MAX_ACTIVE_DEVICES_PER_GUARDIAN=2
