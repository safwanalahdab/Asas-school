# =========================================================
# Core
# =========================================================

SECRET_KEY=generate-a-secure-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost


# =========================================================
# Database
# =========================================================

DB_NAME=asas_school_db
DB_USER=asas_school_user
DB_PASSWORD=PUT_PASSWORD_HERE
DB_HOST=127.0.0.1
DB_PORT=5432

# Optional:
# Defaults to "disable" when DEBUG=True
# and "require" when DEBUG=False.
# DB_SSLMODE=disable


# =========================================================
# Mobile
# =========================================================

MOBILE_MAX_ACTIVE_DEVICES_PER_GUARDIAN=2


# =========================================================
# JWT
# =========================================================

JWT_SIGNING_KEY=change-me

JWT_ACCESS_COOKIE_NAME=asas_web_access
JWT_REFRESH_COOKIE_NAME=asas_web_refresh

# Optional.
# If omitted, Django chooses safe defaults according to DEBUG.
#
# Local development:
# JWT_COOKIE_SECURE=False
# JWT_COOKIE_SAMESITE=Lax
#
# Production:
# JWT_COOKIE_SECURE=True
# JWT_COOKIE_SAMESITE=None

# Usually leave unset so the cookie belongs to the API domain.
# JWT_COOKIE_DOMAIN=


# =========================================================
# Frontend / Backend Origins
# =========================================================

FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
BACKEND_ORIGINS=http://127.0.0.1:8000,http://localhost:8000


# =========================================================
# CSRF
# =========================================================

# Optional.
# If omitted, Django chooses safe defaults according to DEBUG.
#
# Local development:
# CSRF_COOKIE_SECURE=False
# CSRF_COOKIE_SAMESITE=Lax
#
# Production:
# CSRF_COOKIE_SECURE=True
# CSRF_COOKIE_SAMESITE=None


# =========================================================
# Production Security
# =========================================================

# These settings are intentionally disabled by default.
# Enable them only when the final hosting, domain, and proxy setup is known.
# Changing them is not required for the current free Render/Vercel test environment.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False


# =========================================================
# Logging
# =========================================================

# Console logging level. Recommended default: INFO.
LOG_LEVEL=INFO


# =========================================================
# Firebase Push Notifications
# =========================================================

FIREBASE_PUSH_ENABLED=False
FIREBASE_PROJECT_ID=

# Used by Google/Firebase Application Default Credentials
# when Firebase push notifications are enabled.
# GOOGLE_APPLICATION_CREDENTIALS=path/to/firebase-service-account.json
